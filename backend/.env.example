# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed origins for CORS (frontend dev server, etc.).
# With cookie-based auth the browser sends credentials, so this MUST list the
# exact frontend origin(s) — wildcards are not allowed with credentials.
CORS_ORIGIN=http://localhost:5173

# ---- Auth cookies ----
# SameSite policy for the session cookies: lax | strict | none.
#  - 'lax' (default): good when the SPA and API share a site.
#  - 'none': required when the frontend is on a DIFFERENT site; forces Secure
#            and therefore requires HTTPS.
COOKIE_SAMESITE=lax
# Optional cookie name overrides (namespacing per deployment).
# AUTH_COOKIE_NAME=access_token
# CSRF_COOKIE_NAME=csrf_token

# ---- Database ----
# Local MongoDB. For transactions, run as a replica set (see README).
MONGODB_URI=mongodb://127.0.0.1:27017/finance_app

# ---- Auth ----
# Secret used to sign JWT access tokens. NEVER commit a real secret.
# In production this MUST be set, be at least 32 characters, and NOT be this
# placeholder value — the server refuses to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Access token lifetime (zeit/ms format, e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=7d

# Password hashing cost factor (bcrypt). Higher = slower = more secure.
BCRYPT_SALT_ROUNDS=10
